{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Sentinel incident trigger: isolate every Host entity in Microsoft Defender for Endpoint and comment on the incident.",
    "author": "Sam Naz"
  },
  "parameters": {
    "PlaybookName": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "IsolationType": {
      "type": "string",
      "defaultValue": "Full",
      "allowedValues": [
        "Full",
        "Selective"
      ]
    }
  },
  "variables": {
    "connectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('connectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": {
        "hidden-SentinelTemplateName": "[parameters('PlaybookName')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('connectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "IsolationType": {
              "type": "String",
              "defaultValue": "Full"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Hosts": {
              "type": "Query",
              "runAfter": {},
              "inputs": {
                "from": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "where": "@equals(item()?['kind'], 'Host')"
              }
            },
            "For_each_host": {
              "type": "Foreach",
              "foreach": "@body('Hosts')",
              "runAfter": {
                "Hosts": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Has_MDE_device_id": {
                  "type": "If",
                  "runAfter": {},
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "equals": [
                            "@coalesce(items('For_each_host')?['properties']?['additionalData']?['MdatpDeviceId'], '')",
                            ""
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "Isolate_device": {
                      "type": "Http",
                      "runAfter": {},
                      "inputs": {
                        "method": "POST",
                        "uri": "https://api.securitycenter.microsoft.com/api/machines/@{items('For_each_host')?['properties']?['additionalData']?['MdatpDeviceId']}/isolate",
                        "body": {
                          "Comment": "Isolated by Sentinel playbook for incident @{triggerBody()?['object']?['properties']?['incidentNumber']}",
                          "IsolationType": "@parameters('IsolationType')"
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://api.securitycenter.microsoft.com"
                        }
                      }
                    },
                    "Comment_isolated": {
                      "type": "Http",
                      "runAfter": {
                        "Isolate_device": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "method": "PUT",
                        "uri": "https://management.azure.com@{triggerBody()?['object']?['id']}/comments/@{guid()}?api-version=2024-03-01",
                        "body": {
                          "properties": {
                            "message": "Device @{items('For_each_host')?['properties']?['hostName']} isolated in Defender for Endpoint (@{parameters('IsolationType')})."
                          }
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://management.azure.com"
                        }
                      }
                    },
                    "Comment_failed": {
                      "type": "Http",
                      "runAfter": {
                        "Isolate_device": [
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "inputs": {
                        "method": "PUT",
                        "uri": "https://management.azure.com@{triggerBody()?['object']?['id']}/comments/@{guid()}?api-version=2024-03-01",
                        "body": {
                          "properties": {
                            "message": "Isolation FAILED for @{items('For_each_host')?['properties']?['hostName']}. Isolate manually in the Defender portal."
                          }
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://management.azure.com"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Comment_not_onboarded": {
                        "type": "Http",
                        "runAfter": {},
                        "inputs": {
                          "method": "PUT",
                          "uri": "https://management.azure.com@{triggerBody()?['object']?['id']}/comments/@{guid()}?api-version=2024-03-01",
                          "body": {
                            "properties": {
                              "message": "@{items('For_each_host')?['properties']?['hostName']} has no Defender for Endpoint device ID, so it was not isolated."
                            }
                          },
                          "authentication": {
                            "type": "ManagedServiceIdentity",
                            "audience": "https://management.azure.com"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connectionName'))]",
                "connectionName": "[variables('connectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "IsolationType": {
            "value": "[parameters('IsolationType')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'full').identity.principalId]"
    }
  }
}