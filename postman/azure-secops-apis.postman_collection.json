{
  "info": {
    "name": "Azure SecOps APIs",
    "description": "Microsoft Graph Security, Defender for Endpoint and Sentinel REST calls used by the SOAR playbooks. Set tenant_id, client_id and client_secret in an environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "tenant_id",
      "value": ""
    },
    {
      "key": "client_id",
      "value": ""
    },
    {
      "key": "client_secret",
      "value": ""
    },
    {
      "key": "subscription_id",
      "value": ""
    },
    {
      "key": "resource_group",
      "value": "rg-secops"
    },
    {
      "key": "workspace",
      "value": "law-secops"
    },
    {
      "key": "upn",
      "value": "user@contoso.com"
    },
    {
      "key": "machine_id",
      "value": ""
    },
    {
      "key": "graph_token",
      "value": ""
    },
    {
      "key": "mde_token",
      "value": ""
    },
    {
      "key": "arm_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get graph token",
          "request": {
            "method": "POST",
            "url": "https://login.microsoftonline.com/{{tenant_id}}/oauth2/v2.0/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "scope",
                  "value": "https://graph.microsoft.com/.default"
                }
              ]
            },
            "description": "Client credentials token. Store the secret in a Postman vault or environment, never in the collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('graph_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get mde token",
          "request": {
            "method": "POST",
            "url": "https://login.microsoftonline.com/{{tenant_id}}/oauth2/v2.0/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "scope",
                  "value": "https://api.securitycenter.microsoft.com/.default"
                }
              ]
            },
            "description": "Client credentials token. Store the secret in a Postman vault or environment, never in the collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('mde_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get arm token",
          "request": {
            "method": "POST",
            "url": "https://login.microsoftonline.com/{{tenant_id}}/oauth2/v2.0/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "scope",
                  "value": "https://management.azure.com/.default"
                }
              ]
            },
            "description": "Client credentials token. Store the secret in a Postman vault or environment, never in the collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('arm_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Microsoft Graph Security",
      "item": [
        {
          "name": "List high severity alerts (alerts_v2)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "https://graph.microsoft.com/v1.0/security/alerts_v2?$filter=severity eq 'high'&$top=25",
            "description": "Needs SecurityAlert.Read.All.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graph_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('value is an array', () => pm.expect(pm.response.json().value).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List active incidents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "https://graph.microsoft.com/v1.0/security/incidents?$filter=status eq 'active'&$top=25",
            "description": "Needs SecurityIncident.Read.All.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graph_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run advanced hunting query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
            "description": "Needs ThreatHunting.Read.All.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graph_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Query\": \"DeviceProcessEvents | where Timestamp > ago(1d) | where FileName =~ 'powershell.exe' | take 10\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke user sign-in sessions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "https://graph.microsoft.com/v1.0/users/{{upn}}/revokeSignInSessions",
            "description": "Containment step used by Revoke-EntraUserSessions. Needs User.RevokeSessions.All.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graph_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Risky users (Entra ID Protection)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "https://graph.microsoft.com/v1.0/identityProtection/riskyUsers?$filter=riskLevel eq 'high'",
            "description": "Needs IdentityRiskyUser.Read.All.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{graph_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
      ]
    },
